float ripple(float r, float p, float strength, float reach) {
    if (p <= 0.000001 || p >= 0.99999) return 0.0;
    // Manual trigger in silence uses a medium force. Real hits exceed the threshold.
    float energy = strength < 0.0001 ? 0.65 : clamp(strength,0.0,1.0);
    // A real water wave changes amplitude much more than propagation speed.
    float speed = max(baseSpeed,0.2) * (1.0 + energy * max(speedResponse,0.0) * 0.35);
    float travel = (p * 8.0) * speed / max(reach,0.001);
    if (travel >= 1.0) return 0.0;
    float front = (inward ? 1.0-travel : travel) * reach;
    float waveWidth = max(width,0.005);

    // Several damped rings follow the main front, like a drop falling into a puddle.
    // "behind" is positive on the wake side for either direction of travel.
    float behind = (inward ? r-front : front-r) / waveWidth;
    float wakeGate = smoothstep(-0.65,0.15,behind);
    // Outside the wake the ring is exactly zero; beyond 12 widths its
    // maximum contribution is below 1e-10. Avoid exp/sin on those pixels.
    float rings = 0.0;
    if (wakeGate > 0.0 && behind < 12.0) {
        float envelope = exp(-0.16*behind*behind) * wakeGate;
        rings = sin(behind*4.35 + 0.55) * envelope;
    }

    // A short central dimple makes the beginning read as an impact instead of a wipe.
    float impact = 0.0;
    if (!inward) {
        float centerDistance = r / (waveWidth*1.15);
        impact = -exp(-centerDistance*centerDistance) * exp(-travel*22.0) * 0.85;
    }

    float life = smoothstep(0.0,0.02,travel) * (1.0-smoothstep(0.82,1.0,travel));
    // Exponent > 1 preserves and emphasizes the contrast between soft and hard kicks.
    float height = pow(energy,1.25) * exp(-travel*max(decay,0.0));
    return (rings + impact) * life * height;
}
void main(){
    vec2 uv = isf_FragNormCoord.xy;
    if (amount <= 0.0 && !showDiagnostics) {
        gl_FragColor=IMG_NORM_PIXEL(inputImage,uv);
        return;
    }
    float aspect=RENDERSIZE.x/max(RENDERSIZE.y,1.0);
    vec2 center=vec2(centerX,centerY);
    vec2 delta=(uv-center)*vec2(aspect,1.0);
    float radius=length(delta);
    float reach=length(max(center,1.0-center)*vec2(aspect,1.0)) + width*2.0;
    float sum=0.0;
    sum += ripple(radius,progress0,strength0,reach);
    sum += ripple(radius,progress1,strength1,reach);
    sum += ripple(radius,progress2,strength2,reach);
    sum += ripple(radius,progress3,strength3,reach);
    sum += ripple(radius,progress4,strength4,reach);
    sum += ripple(radius,progress5,strength5,reach);
    sum += ripple(radius,progress6,strength6,reach);
    sum += ripple(radius,progress7,strength7,reach);
    float limitedSum = sum / (1.0 + 0.55 * abs(sum));
    float displacement=amount*clamp(limitedSum,-1.35,1.35)*smoothstep(0.0,0.025,radius);
    vec2 warped=uv+(delta/max(radius,0.00001))*displacement/vec2(aspect,1.0);
    warped=1.0-abs(mod(warped,2.0)-1.0);
    vec4 color=IMG_NORM_PIXEL(inputImage,warped);
    if (showDiagnostics && uv.x < 0.34 && uv.y > 0.79) {
        vec2 panel = vec2(uv.x / 0.34, (uv.y - 0.79) / 0.21);
        float row = floor(panel.y * 5.0);
        float localY = fract(panel.y * 5.0);
        float value = row < 1.0 ? clamp(diagEnergy,0.0,1.0) :
                      row < 2.0 ? clamp(diagReference,0.0,1.0) :
                      row < 3.0 ? clamp(diagTransient*4.0,0.0,1.0) :
                      row < 4.0 ? clamp(diagThreshold*4.0,0.0,1.0) : fract(diagCount/10.0);
        vec3 barColor = row < 1.0 ? vec3(0.15,0.65,1.0) :
                        row < 2.0 ? vec3(0.65,0.35,1.0) :
                        row < 3.0 ? vec3(0.15,1.0,0.45) :
                        row < 4.0 ? vec3(1.0,0.55,0.12) : vec3(0.95);
        float insideBar = step(panel.x, value) * step(0.16,localY) * step(localY,0.84);
        vec3 hud = mix(vec3(0.025), barColor, insideBar);
        if (diagDetected && panel.x > 0.93) hud = vec3(0.1,1.0,0.25);
        color.rgb = mix(color.rgb, hud, 0.88);
    }
    gl_FragColor=color;
}
