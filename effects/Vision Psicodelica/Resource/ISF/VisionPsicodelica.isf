const float TAU=6.28318530718;
vec2 mirrored(vec2 p){return 1.0-abs(mod(p,2.0)-1.0);}
vec3 straightColor(vec4 c){return c.rgb/max(c.a,.0001);}
float light(vec3 c){return dot(c,vec3(.2126,.7152,.0722));}
// Explicit bilinear reconstruction keeps subpixel warps continuous even if
// the host's image sampler is configured for nearest sampling.
vec4 videoSample(vec2 uv){
 vec2 size=max(IMG_SIZE(inputImage),vec2(1));
 vec2 p=mirrored(uv)*size-.5,base=floor(p),f=fract(p);
 vec2 a=(base+.5)/size,b=(base+1.5)/size;
 return mix(mix(IMG_NORM_PIXEL(inputImage,clamp(a,vec2(.5)/size,1.0-vec2(.5)/size)),
                IMG_NORM_PIXEL(inputImage,clamp(vec2(b.x,a.y),vec2(.5)/size,1.0-vec2(.5)/size)),f.x),
            mix(IMG_NORM_PIXEL(inputImage,clamp(vec2(a.x,b.y),vec2(.5)/size,1.0-vec2(.5)/size)),
                IMG_NORM_PIXEL(inputImage,clamp(b,vec2(.5)/size,1.0-vec2(.5)/size)),f.x),f.y);
}
vec3 sourceColor(vec2 p){return straightColor(videoSample(p));}
vec3 analysisColor(vec2 p){return straightColor(IMG_NORM_PIXEL(analysisImage,mirrored(p)));}
float analysisLight(vec2 p){return light(analysisColor(p));}
vec3 rainbow(float x){return .54+.46*cos(TAU*(vec3(.04,.36,.69)+x));}
float hashValue(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float valueField(vec2 p){
 vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);
 return mix(mix(hashValue(i),hashValue(i+vec2(1,0)),f.x),
            mix(hashValue(i+vec2(0,1)),hashValue(i+vec2(1,1)),f.x),f.y);
}
// Three bounded octaves; no per-pixel texture iteration or ray marching.
float fractalField(vec2 p){
 float v=.5714286*valueField(p);
 p=mat2(.8,-.6,.6,.8)*p*2.0+vec2(3.7,9.2);
 v+=.2857143*valueField(p);
 p=mat2(.8,-.6,.6,.8)*p*2.0+vec2(7.1,2.6);
 return v+.1428571*valueField(p);
}
vec4 features(vec2 uv,vec2 radius,float c){
 float n=analysisLight(uv+vec2(0,radius.y)),s=analysisLight(uv-vec2(0,radius.y));
 float e=analysisLight(uv+vec2(radius.x,0)),w=analysisLight(uv-vec2(radius.x,0));
 float mean=(c*4.0+n+s+e+w)/8.0;
 float contrast=(abs(n-mean)+abs(s-mean)+abs(e-mean)+abs(w-mean))*.25;
 return vec4(mean,(e-w)*.5,(n-s)*.5,contrast);
}
// Soft antialiased ribbons. Undersampled bands fade out.
float ribbon(float band,float width){
 float derivative=fwidth(band);
 float distanceToLine=abs(fract(band+.5)-.5);
 float aa=max(derivative*.75,.006);
 float line=1.0-smoothstep(width,width+aa,distanceToLine);
 return line*(1.0-smoothstep(.13,.40,derivative));
}
void main(){
 vec2 uv=isf_FragNormCoord.xy;
 vec4 original=IMG_NORM_PIXEL(inputImage,uv);
 if(mixAmount<=.000001){gl_FragColor=original;return;}
 float aspect=RENDERSIZE.x/max(RENDERSIZE.y,1.0);
 vec2 asp=vec2(aspect,1.0);
 // All animation is periodic at phase wrap, including the fractal domains.
 float t=phase*TAU;
 // A separate integrated phase animates the geometry without shifting video UVs.
 // Its frequency is driven by the automatic/audio controls in the Wire graph.
 float pt=patternPhase*TAU;
 vec2 orbit=vec2(cos(pt),sin(pt))*(.8*patternMotion);
 float patternShift=sin(pt)*patternMotion*.85;
 float bass=clamp(audioLevel*bassGain,0.0,1.0);
 float drive=1.0+bass*bassReactive*.6;
 vec2 radius=vec2(imageScale)/asp;
 // Reuse center samples shared by gradients, motion and chroma analysis.
 vec3 analyzed0=analysisColor(uv);
 float analyzedLum=light(analyzed0);
 vec4 f=features(uv,radius,analyzedLum);
 float presence=smoothstep(.003,.055,length(f.yz)*2.0+f.w*1.4);
 float motion=0.0;
 if(flowResponse!=0.0){
  float oldLum=light(straightColor(IMG_NORM_PIXEL(previousImage,uv)));
  motion=clamp((analyzedLum-oldLum)*2.0,-.25,.25);
 }
 vec2 normal=f.yz/(.08+length(f.yz));
 vec2 tangent=vec2(-normal.y,normal.x);
 vec2 domain=vec2(f.x*4.0,(analyzed0.r-analyzed0.b)*2.2+f.w*3.0);
 float bend=fractalField(domain+orbit)*2.0-1.0;
 vec2 flow=tangent*sin(t+f.x*TAU)+normal*cos(t-f.x*TAU)*.3;
 flow+=normal*(bend*branchAmount*.4+motion*flowResponse);
 vec2 warped=uv+flow*warping*drive/asp;
 warped+=(uv-.5)*(.005*breathing*sin(t)*presence);
 vec2 split=normal*chromatic*drive/asp;
 vec4 middle=videoSample(warped);
 vec3 c=straightColor(middle);
 if(chromatic!=0.0){
  c.r=sourceColor(warped+split).r;c.b=sourceColor(warped-split).b;
 }
 vec3 analyzed=analysisColor(warped);
 vec4 shape=features(warped,radius,light(analyzed));
 // Geometry uses filtered source features; output retains full-resolution video.
 float relief=clamp((light(analyzed)-shape.x)*imageRelief,-.12,.12);
 vec2 q=vec2(shape.x*4.0,(analyzed.r-analyzed.b)*2.2+shape.w*3.0);
 q+=branchAmount*.35*vec2(bend,fractalField(q+vec2(4.1,7.3)-orbit)-.5);
 float branches=fractalField(q+orbit);
 float height=shape.x+relief*.18+(analyzed.g-analyzed.b)*.04;
 height+=(branches-.5)*branchAmount*.14*presence;
 // Keep spatial band spacing stable. Audio advances the integrated phase
 // and gently modulates the warp/brightness instead of shaking every band.
 float frequency=contourDensity;
 float contour=ribbon(height*frequency+patternShift,.055);
 float fine=ribbon((height+shape.w*.15)*frequency*1.75-patternShift*.6,.035);
 float ornament=ribbon((height+(branches-.5)*.12)*frequency*1.3+patternShift*.35,.045);
 float geometry=clamp(contour*.65+fine*microDetail*.25+ornament*branchAmount*.4,0.0,1.0)*presence;
 // Near-zero gradients no longer cause discontinuous hue rotation.
 vec3 ink=rainbow(height*1.6+branches*.2+.06*sin(pt)*min(patternMotion,1.0));
 float l=light(c);c=mix(vec3(l),c,saturation);
 float opacity=clamp(geometry*patternAmount*.65*drive,0.0,.60);
 c=mix(c,ink*.84+.08,opacity);
 float effectiveIridescence=clamp(iridescence+clamp(noKickAmount,0.0,1.0)*noKickBoost,0.0,1.0);
 c=mix(c,c*(.85+ink*.3)+ink*.012,effectiveIridescence*presence*.4);
 float edge=smoothstep(.015,.16,length(shape.yz));
 c=mix(c,ink,clamp(contour*edge*contourAmount*.22*drive,0.0,.32));
 float a=middle.a;
 vec4 current=vec4(clamp(c,0.0,1.0)*a,a);
 vec4 result=current;
 if(trailAmount>0.0){
  vec4 history=IMG_NORM_PIXEL(historyImage,mirrored(uv-flow*warping*.04/asp));
  result=mix(current,history,clamp(trailAmount,0.0,.65));
 }
 result.rgb=clamp(result.rgb,vec3(0.0),vec3(result.a));
 gl_FragColor=mix(original,result,clamp(mixAmount,0.0,1.0));
}
